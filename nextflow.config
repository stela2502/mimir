// Define parameters before process/profile configuration is evaluated.
params {
    samples = "${projectDir}/config/datasets.tsv"
    outdir = "${launchDir}/mimir_results"
    min_umi_count = 800
    variable_genes = 2000
    pca_components = 30
    merge_pearson = 0.95
    max_parallel = 1
    lumrik_image = 'ghcr.io/stela2502/lumrik:v0.9.2'
    sc_analyse = 'sc-analyse'
    run_gex = true
    run_annotate = false
    run_split = false
    preflight_check_runtime = true
    preflight_profile = 'local'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxForks = params.max_parallel
    shell = ['/bin/bash', '-ue']
    container = params.lumrik_image
}
profiles {
    local {
        process.container = null
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    slurm {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
